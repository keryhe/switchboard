{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "UserTokenSigningKey": "dev-only-sample-user-signing-key-change-me-32+"
  },
  "Switchboard": {
    "Url": "https://localhost:7000",
    "ServerToken": "<generate with: dotnet switchboard token generate --role appserver ...>"
  }
}
