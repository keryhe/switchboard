<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.10" />
    <!-- Only for TestSupport/PostgresContainerFixture.cs (linked below) — the Slice 7 rolling-restart
         milestone needs genuinely separate `dotnet` processes clustering through a real database,
         since UseLocalhostClustering's static in-memory membership table does not cross process
         boundaries the way it does for the in-process two-silo unit tests. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reused as-is from the UnitTests project (Phase 3 Slice 6) rather than duplicated — same
         throwaway postgres:16-alpine-via-Docker-CLI fixture, same vendored schema scripts. -->
    <Compile Include="..\Keryhe.Switchboard.UnitTests\TestSupport\PostgresContainerFixture.cs" Link="TestSupport\PostgresContainerFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Keryhe.Switchboard.Core\Keryhe.Switchboard.Core.csproj" />
    <ProjectReference Include="..\..\src\Keryhe.Switchboard.Protocol\Keryhe.Switchboard.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Keryhe.Switchboard.Server\Keryhe.Switchboard.Server.csproj" />
  </ItemGroup>

</Project>
